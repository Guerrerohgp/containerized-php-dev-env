# Environment files - CRITICAL: Never commit these
.env
.env.*
!.env.example

# SSL certificates - generated locally
docker/ssl/certs/*.crt
docker/ssl/certs/*.key
docker/ssl/certs/*.pem
!docker/ssl/certs/.gitkeep

# Database backups
backups/
*.sql
*.sql.gz

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100/
.Trashes/
.TemporaryItems/
.fseventsd/
.DocumentRevisions-V100/
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.stackdump
*:Zone.Identifier

# Linux
*~
.directory
.Trash-*/
.nfs*

# IDE / Editor
.idea/
.vscode/
*.swp
*.swo
*.swn
*.sublime-workspace
.history/
.#*
\#*#

# Temporary files
*.tmp
*.temp
*.bak
*.orig
*.rej

# Logs
*.log
logs/

# Dependencies (if any project files added)
node_modules/
vendor/

# PHP tooling and test output
.phpunit.cache/
.phpunit.result.cache
.php-cs-fixer.cache
/coverage/

# JavaScript tooling caches
.npm/
.eslintcache
.stylelintcache
.parcel-cache/
.vite/

# Python test helpers and local environments
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# Local code index (each checkout generates its own)
/.codegraph/

# Docker volumes backup
*.tar
*.tar.gz
