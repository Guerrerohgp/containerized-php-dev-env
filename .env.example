# ===========================================
# Project Configuration
# ===========================================
PROJECT_NAME=myapp
PROJECT_DOMAIN=myapp.test
# Relative to src/. Empty: detect public/, web/, or an index in src/.
APP_DOCUMENT_ROOT=

# ===========================================
# PHP Configuration
# ===========================================
# Default tracks the latest stable branch reviewed by this project; PHP has no separate LTS edition.
# PHP versions: 7.4, 8.0, 8.1, 8.2, 8.3, 8.4, 8.5 (default)
# Debian base is selected automatically: Bullseye for 7.4/8.0, Bookworm for 8.1+.
PHP_VERSION=8.5
# Enable the smaller PHP 8.5-only image through ./dev or dev.bat.
lite=false
PHP_POST_MAX_SIZE=100M
PHP_UPLOAD_MAX_FILESIZE=100M
PHP_MAX_EXECUTION_TIME=300
PHP_SHORT_OPEN_TAG=On

# ===========================================
# Node.js Configuration
# ===========================================
NODE_VERSION=20

# ===========================================
# User/Group IDs (for file permissions)
# ===========================================
# macOS/Linux: typically 1000 (run `id -u` to check)
# Windows: can usually leave as default
WWWUSER=1000
WWWGROUP=1000

# ===========================================
# Application Port
# ===========================================
APP_PORT=8080
HMR_PORT=8081

# ===========================================
# Database Configuration
# ===========================================
# MySQL
MYSQL_VERSION=8.0
DB_DATABASE=myapp
DB_USERNAME=myapp
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root
FORWARD_DB_PORT=3306

# PostgreSQL
POSTGRES_VERSION=16
POSTGRES_DB=myapp
POSTGRES_USER=myapp
POSTGRES_PASSWORD=secret
FORWARD_POSTGRES_PORT=5432

# ===========================================
# Redis Configuration
# ===========================================
REDIS_ENABLED=true
FORWARD_REDIS_PORT=6379

# ===========================================
# Mailpit Configuration (Email Testing)
# ===========================================
MAILPIT_ENABLED=true
MAILPIT_HOST=mailpit
MAILPIT_PORT=1025
MAILPIT_FROM_EMAIL=noreply@myapp.test
MAILPIT_FROM_NAME=MyApp
FORWARD_MAILPIT_PORT=1025
FORWARD_MAILPIT_DASHBOARD_PORT=8025

# ===========================================
# SSL Configuration
# ===========================================
SSL_ENABLED=true
SSL_PORT=8443

# ===========================================
# Xdebug Configuration
# ===========================================
SAIL_XDEBUG_MODE=off
SAIL_XDEBUG_CONFIG=client_host=host.docker.internal

# ===========================================
# Platform Notes
# ===========================================
# macOS:
#   - Docker Desktop required
#   - Run: ./dev up
#   - SSL: ./dev ssl (then follow prompts)
#
# Linux:
#   - Docker 20.10+ or Podman required
#   - Run: ./dev up
#   - May need to run with sudo or add user to docker group
#
# Windows:
#   - Docker Desktop required with WSL2 backend
#   - Run: dev.bat up
#   - Or use WSL/PowerShell: ./dev up
#   - SSL: dev.bat ssl
