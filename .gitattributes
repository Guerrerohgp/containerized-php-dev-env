# Auto detect text files and perform LF normalization
* text=auto

# Shell scripts should always use LF
*.sh text eol=lf
plod text eol=lf
install.sh text eol=lf
docker/php/start-container text eol=lf
docker/php/nginx-default text eol=lf
docker/mysql/create-testing-database.sh text eol=lf
docker/postgres/create-testing-database.sh text eol=lf

# Batch files should always use CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Config files
*.yml text
*.yaml text
*.json text
*.xml text
*.ini text eol=lf
*.conf text eol=lf

# PHP/JS/HTML
*.php text
*.js text
*.ts text
*.html text
*.css text
*.scss text
*.vue text

# Docker
Dockerfile text
docker-compose*.yml text
